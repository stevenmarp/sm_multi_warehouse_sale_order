<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_order_form_multi_warehouse" model="ir.ui.view">
        <field name="name">sale.order.form.inherit.sm.multi.warehouse</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale_stock.view_order_form_inherit_sale_stock"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='picking_policy']" position="after">
                <field name="warehouse_mode"
                       groups="stock.group_stock_multi_warehouses"
                       readonly="state == 'sale'"/>
            </xpath>
            <!-- If warehouse_id is not already present, insert it -->
            <xpath expr="//field[@name='order_line']/list/field[@name='product_uom_qty'][not(../field[@name='warehouse_id'])]" position="after" fail_if_not_found="0">
                <field name="warehouse_id"
                       optional="show"
                       options="{'no_create': True}"
                       groups="stock.group_stock_multi_warehouses"
                       column_invisible="parent.warehouse_mode != 'line'"
                       readonly="parent.state == 'sale'"
                       force_save="1"/>
            </xpath>
            <!-- If warehouse_id is already present, modify its attributes to support Warehouse Mode -->
            <xpath expr="//field[@name='order_line']/list/field[@name='warehouse_id']" position="attributes" fail_if_not_found="0">
                <attribute name="column_invisible">parent.warehouse_mode != 'line'</attribute>
                <attribute name="groups">stock.group_stock_multi_warehouses</attribute>
                <attribute name="options">{'no_create': True}</attribute>
                <attribute name="readonly">parent.state == 'sale'</attribute>
                <attribute name="force_save">1</attribute>
            </xpath>
            <!-- Always add the allocation wizard button after product_uom_qty -->
            <xpath expr="//field[@name='order_line']/list/field[@name='product_uom_qty']" position="after">
                <button name="action_open_allocation_wizard"
                        type="object"
                        icon="fa-list"
                        title="Warehouse Allocation"
                        groups="stock.group_stock_multi_warehouses"
                        column_invisible="parent.warehouse_mode != 'multi'"/>
            </xpath>
            <xpath expr="//field[@name='order_line']/form//field[@name='route_id']" position="after">
                <field name="warehouse_id"
                       options="{'no_create': True}"
                       groups="stock.group_stock_multi_warehouses"
                       invisible="parent.warehouse_mode != 'line'"
                       readonly="parent.state == 'sale'"
                       force_save="1"/>
            </xpath>
            <xpath expr="//field[@name='order_line']/form/group" position="after">
                <label for="warehouse_line_ids"
                       groups="stock.group_stock_multi_warehouses"
                       invisible="display_type or parent.warehouse_mode != 'multi'"/>
                <field name="warehouse_line_ids"
                       groups="stock.group_stock_multi_warehouses"
                       invisible="display_type or parent.warehouse_mode != 'multi'"
                       readonly="parent.state == 'sale'"
                       force_save="1">
                    <list editable="bottom">
                        <field name="warehouse_id" options="{'no_create': True}"/>
                        <field name="free_qty"/>
                        <field name="quantity"/>
                    </list>
                </field>
            </xpath>
        </field>
    </record>

    <record id="view_sale_order_line_allocation_form" model="ir.ui.view">
        <field name="name">sale.order.line.allocation.form</field>
        <field name="model">sale.order.line</field>
        <field name="arch" type="xml">
            <form string="Warehouse Allocation">
                <group>
                    <field name="product_id" readonly="1"/>
                    <field name="product_uom_qty" readonly="1"/>
                </group>
                <label for="warehouse_line_ids"/>
                <field name="warehouse_line_ids">
                    <list editable="bottom">
                        <field name="warehouse_id" options="{'no_create': True}"/>
                        <field name="free_qty"/>
                        <field name="quantity"/>
                    </list>
                </field>
                <footer>
                    <button string="Save &amp; Close" class="btn-primary" special="save" data-hotkey="q"/>
                    <button string="Discard" class="btn-secondary" special="cancel" data-hotkey="x"/>
                </footer>
            </form>
        </field>
    </record>

</odoo>
